{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hostealo Terminal",
  "mainBinaryName": "hostealo-terminal",
  "version": "0.1.3",
  "identifier": "es.hostealo.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hostealo Terminal",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "SSH, SFTP, FTP and RDP client by Hostealo",
    "copyright": "Copyright 2026 Hostealo. FSL-1.1-ALv2.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "bundleVersion": "8"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERkM2QjBBMTBDN0Q4NjcKUldSbjJNY1FDbXY4L2F4dXRLc3Q1VElseC9lU3p2cUM3SUJ6NUFCVEQ2RzVCRlhzdy9FN2tlK3MK",
      "endpoints": [
        "https://github.com/hostealo-org/hostealo-terminal/releases/latest/download/latest.json"
      ]
    }
  }
}
